[Unit]
Description=x11vnc Wayland connection %i
After=graphical-session.target
Requires=graphical-session.target
PartOf=x11vnc-wayland.socket

[Service]
Type=simple
WorkingDirectory=%h/Documents/x11vnc-wayland-bridge
ExecStart=%h/Documents/x11vnc-wayland-bridge/start_x11vnc_wayland_ondemand.sh --inetd
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStopSec=5
